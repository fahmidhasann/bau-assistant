# Used only by the server-side chat fallback. Structured lookups work without it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required only when running `npm run sync:data`.
# Get this value from the BAU directory service owner; never expose it to the browser.
BAU_SYNC_API_KEY=
